# Copy to .env and fill in. .env is gitignored.

# Anthropic API key (only needed when llm.provider = anthropic in config.yaml)
ANTHROPIC_API_KEY=

# Secret used to pseudonymise member IDs before anything is sent to an LLM.
# Any long random string. Changing it changes every token (and invalidates the LLM cache).
PSEUDONYM_SECRET=change-me-to-a-long-random-string
